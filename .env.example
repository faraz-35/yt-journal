# Copy this file to .env and fill in your values.
# Your Z.AI (Zhipu) API key — get it from https://open.bigmodel.cn
ZAI_API_KEY=your_z_ai_key_here

# Model to use for summarization. glm-4.5-air is fast + cheap and good enough
# for a transcript summary. Pair with thinking:disabled in summarize.mjs.
ZAI_MODEL=glm-4.5-air

# Z.AI OpenAI-compatible endpoint. api.z.ai = international (fast/reliable);
# open.bigmodel.cn = China (often unreachable from outside China).
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Port the daemon listens on. localhost only.
HELPER_PORT=8776

# Where entries are written. Defaults to the about-me skill dir so any agent
# reading your profile picks this up automatically. Override only for testing.
# YTJOURNAL_DIR=~/.agents/skills/about-me/yt-journal

# ---- AMO self-signing (make the extension persist on Firefox Release) ----
# Create credentials at https://addons.mozilla.org/developers/ → API Keys.
# Used by `npm run sign`. Keep these in .env (never committed).
WEB_EXT_API_KEY=user:your_jwt_issuer_here
WEB_EXT_API_SECRET=your_jwt_secret_here
